# Copy this file to `.env.deploy` and fill in the values.
# `.env.deploy` is git-ignored (.env*) and excluded from the Vercel upload (.vercelignore).

# --- Vercel access ---------------------------------------------------------
VERCEL_TOKEN=
# Optional: team id/slug (only if the project lives under a team, not your personal account)
VERCEL_SCOPE=
# Optional: project name to create/link on Vercel (defaults to "bhoomi-plots")
VERCEL_PROJECT_NAME=bhoomi-plots

# --- App environment variables (pushed to Vercel "production" on each deploy) ---
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
